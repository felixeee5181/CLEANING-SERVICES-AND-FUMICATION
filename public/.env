# ───────────── Server ─────────────
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000

# ───────────── Database (PostgreSQL) ─────────────
DATABASE_URL=postgresql://user:password@localhost:5432/sparkleclean
PGSSL=false

# ───────────── Admin panel ─────────────
ADMIN_PATH=adminsecrete
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
JWT_SECRET=change_me_to_a_long_random_string

# ───────────── Brevo (transactional email) ─────────────
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=randywarren202@gmail.com
BREVO_SENDER_NAME=SparkleClean
OWNER_EMAIL=owner@sparkleclean.com

# ───────────── Uploads ─────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
